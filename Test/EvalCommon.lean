/-
Milestone 7 (evaluation), shared by the corpus extractor and the harness: the auxiliary
filters, the oracle-H filter of EVAL_PLAN §2.3, elimination detection, and the Tier B
proof walker. Tier B goals are stored as (theorem, position in the walk), and the harness
rebuilds them with this same walker, so the two can never disagree.
-/
import Lean
import Test.Util

open Lean Meta

namespace Eval

/-! ## Fixed parameters (pre-registered in NOTES.md, milestone 7) -/

def tierACap : Nat := 3000
def tierBTheorems : Nat := 1000
def tierBPerTheorem : Nat := 10
def tierBCap : Nat := 3000
/-- Visit budget of the Tier B walker, per theorem (proof-term nodes, with sharing
unfolded). A theorem whose walk is cut is still used, with the goals found so far. -/
def walkBudget : Nat := 20000
def seedASample : UInt64 := 70001
def seedBTheorems : UInt64 := 70002
def seedBPerTheorem : UInt64 := 70003
def seedBTotal : UInt64 := 70004
def sourceModules : Array Name := #[`Init, `Std]

/-! ## Names -/

/-- Strip the `_private.<module>.<n>.` prefix of a private name. -/
def userName (n : Name) : Name := (privateToUserName? n).getD n

/-- Generated by the compiler for a declaration, not written by a user (EVAL_PLAN §2.1,
extended in NOTES.md milestone 7). -/
def generatedSuffixes : List String :=
  ["inj", "injEq", "sizeOf_spec", "congr_simp", "induct", "induct_unfolding",
   "mutual_induct", "fun_cases", "fun_cases_unfolding", "splitter"]

def isEqnSuffix (s : String) : Bool :=
  s == "eq_def" || s == "eq_unfold" ||
  (s.startsWith "eq_" && (s.drop 3).toString.all Char.isDigit && (s.drop 3).toString != "")

/-- Some component (after the private prefix) starts with `_`: `_proof_N`, `_simp_N_N`,
`_auxLemma`, `_unary`, … -/
def isInternalAux (n : Name) : Bool := (userName n).isInternal

/-- Some prefix of `n` is a matcher (`foo.match_1.eq_2`, `foo.match_1.splitter`). -/
def underMatcher (env : Environment) (n : Name) : Bool := Id.run do
  let mut p := n
  while !p.isAnonymous do
    if isMatcherCore env p then return true
    p := p.getPrefix
  return false

def isRecursorLike (env : Environment) (n : Name) : Bool :=
  isRecCore env n || isAuxRecursor env n || isCasesOnRecursor env n || isNoConfusion env n

/-- An auxiliary constant in the sense of §2.3 (dropped from oracle H). -/
def isAuxConst (env : Environment) (n : Name) : Bool :=
  isInternalAux n || isMatcherCore env n || underMatcher env n || isRecursorLike env n

/-! ## Elimination constants (§2.1) -/

def elimNames : List Name :=
  [``Eq.mpr, ``Eq.rec, ``Eq.ndrec, ``Eq.subst, ``False.elim, ``absurd]

def isElim (env : Environment) (n : Name) : Bool :=
  elimNames.contains n || isRecCore env n || isAuxRecursor env n ||
  isCasesOnRecursor env n || isMatcherCore env n

/-- The constants of `e`, looking through internal auxiliary theorems (`_proof_N`,
`_simp_N`, …), which the elaborator abstracts out of a proof: they are part of it. The
auxiliary constants themselves are kept in the result (the H filter drops them). -/
partial def usedConstants (env : Environment) (e : Expr) : Array Name := Id.run do
  let mut seen : Std.HashSet Name := {}
  let mut out : Array Name := #[]
  let mut todo := e.getUsedConstants.toList
  while true do
    match todo with
    | [] => break
    | c :: rest =>
      todo := rest
      if seen.contains c then continue
      seen := seen.insert c
      out := out.push c
      if isInternalAux c then
        if let some (.thmInfo t) := env.find? c then
          todo := t.value.getUsedConstants.toList ++ todo
  return out

def builtinRules : List Name :=
  [``And.intro, ``Or.inl, ``Or.inr, ``Exists.intro, ``Iff.intro, ``True.intro,
   ``And.left, ``And.right, ``Iff.mp, ``Iff.mpr]

/-- §2.3: `"proof"` or `"data"` to keep; otherwise the reason it is dropped (`builtin`,
`aux`, `instance`, `type former`). -/
def classifyH (c : Name) : MetaM String := do
  let env ← getEnv
  let some ci := env.find? c | return "unknown"
  if builtinRules.contains c then return "builtin"
  if isAuxConst env c then return "aux"
  if ← isInstance c then return "instance"
  -- any proof constant: a theorem, an axiom, a constructor of an inductive proposition
  -- (`Eq.refl`), or a definition whose type is a proposition (`rfl`); NOTES.md milestone 7
  if ← isProp ci.type then return "proof"
  if ← isTypeFormerType ci.type then return "type former"
  return "data"

/-- Oracle H of a set of constants: kept constants with their kind (`proof`/`data`), in
name order, and dropped ones with reasons. -/
def oracleH (cs : Array Name) : MetaM (Array (Name × String) × Array (Name × String)) := do
  let mut keep := #[]
  let mut drop := #[]
  for c in cs do
    let r ← classifyH c
    if r == "proof" || r == "data" then keep := keep.push (c, r) else drop := drop.push (c, r)
  let lt := fun (a b : Name × String) => decide (a.1.toString < b.1.toString)
  return (keep.qsort lt, drop.qsort lt)

/-- The two oracle H sets of EVAL_PLAN §10.2. -/
structure OracleH where
  /-- every kept constant (the §2.3 set of 7a) -/
  full : Array Name
  /-- the data constants of `full` -/
  dataFull : Array Name
  /-- proof constants, and data constants that occur neither in the goal's closed type nor
  in the type of any proof constant of `full` -/
  main : Array Name
  /-- data constants of `full` left out of `main` -/
  dataDropped : Array Name
  dropped : Array (Name × String)
  /-- the goal's own declaration (Tier A) or source theorem (Tier B) was among the kept
  constants; it is removed from both sets -/
  selfHit : Bool
  /-- removed from `main` by EVAL_PLAN §10.4, with the reason: `id` (transparent) or
  `elimination` -/
  mainRemoved : Array (Name × String) := #[]
  /-- `Eq.mp`, `cast`, `dite`, `ite` that survived the §10.2 data rule: elimination
  constants of this goal (§10.4) -/
  extraElims : Array Name := #[]
  deriving Inhabited

/-- §10.4: casts along an equality and case splits on a decidable proposition, elimination
constants when they survive the §10.2 data rule. -/
def extraElimNames : List Name := [``Eq.mp, ``cast, ``dite, ``ite]

def splitH (goalTy : Expr) (self : Name) (cs : Array Name) : MetaM OracleH := do
  let (keep, dropped) ← oracleH cs
  let selfHit := keep.any (·.1 == self)
  let keep := keep.filter (·.1 != self)
  let env ← getEnv
  -- constants of the goal's closed type and of the types of the kept proof constants
  let mut occ : Std.HashSet Name := Std.HashSet.ofArray goalTy.getUsedConstants
  for (c, k) in keep do
    if k == "proof" then
      if let some ci := env.find? c then
        occ := occ.insertMany ci.type.getUsedConstants
  let dataFull := keep.filterMap fun (c, k) => if k == "data" then some c else none
  let dataDropped := dataFull.filter occ.contains
  let main := keep.filterMap fun (c, k) =>
    if k == "proof" || !occ.contains c then some c else none
  -- §10.4: `id` is transparent; elimination constants (§2.1, and the four of §10.4 when
  -- they survive the data rule, which is exactly when they are still in `main`) leave H_main
  let reason := fun (c : Name) =>
    if c == ``id then some "id"
    else if isElim env c || extraElimNames.contains c then some "elimination"
    else none
  let mainRemoved := main.filterMap fun c => (reason c).map (c, ·)
  let extraElims := main.filter extraElimNames.contains
  let main := main.filter fun c => (reason c).isNone
  return { full := keep.map (·.1), dataFull, main, dataDropped, dropped, selfHit,
           mainRemoved, extraElims }

def elimsOf (env : Environment) (cs : Array Name) : Array Name :=
  (cs.filter (isElim env)).qsort (·.toString < ·.toString)

/-- Number of distinct subterms (proof size with sharing). -/
def dagSize (e : Expr) : Nat := Id.run do
  let mut seen : Std.HashSet Expr := {}
  let mut todo := [e]
  while true do
    match todo with
    | [] => break
    | x :: rest =>
      todo := rest
      if seen.contains x then continue
      seen := seen.insert x
      todo := match x with
        | .app f a => f :: a :: todo
        | .lam _ t b _ | .forallE _ t b _ => t :: b :: todo
        | .letE _ t v b _ => t :: v :: b :: todo
        | .mdata _ b | .proj _ _ b => b :: todo
        | _ => todo
  return seen.size

/-! ## The Tier B walker (§2.2) -/

structure WalkSt where
  visited : Nat := 0
  truncated : Bool := false
  /-- Candidates in walk order, closed over their enclosing binders:
  (closed goal type `∀ ctx, T`, closed proof `fun ctx => e`, number of binders). -/
  cands : Array (Expr × Expr × Nat) := #[]
  /-- Oracle node estimate mode: count instead of collecting. -/
  nodes : Nat := 0

abbrev WalkM := StateRefT WalkSt MetaM

def isProofSafe (e : Expr) : MetaM Bool := do
  try isProof e catch _ => return false

/-- Walk the proof positions of `e`: λ-bodies (binders entered as local declarations),
`let` values and bodies (zeta), application heads and arguments, `mdata`, `proj`. Binder
types are not walked. With `collect`, record every proof-valued application with at least
one argument whose head is a constant or a local hypothesis; otherwise count every
proof-valued spine headed by a constant or a local hypothesis (the node estimate). -/
partial def walk (collect : Bool) (e : Expr) (ctx : Array Expr) : WalkM Unit := do
  if (← get).visited ≥ walkBudget then
    modify fun s => { s with truncated := true }
    return
  modify fun s => { s with visited := s.visited + 1 }
  match e with
  | .lam n t b bi =>
    withLocalDecl n bi t fun x => walk collect (b.instantiate1 x) (ctx.push x)
  | .letE _ _ v b _ =>
    walk collect v ctx
    walk collect (b.instantiate1 v) ctx
  | .mdata _ b | .proj _ _ b => walk collect b ctx
  | .const .. | .fvar .. | .app .. =>
    let f := e.getAppFn
    let nargs := e.getAppNumArgs
    let headOk ← match f with
      | .const .. => pure true
      | .fvar .. => isProofSafe f
      | _ => pure false
    if headOk && (!collect || nargs ≥ 1) then
      if ← isProofSafe e then
        if collect then
          let ty ← instantiateMVars (← inferType e)
          let c := (← mkForallFVars ctx ty, ← mkLambdaFVars ctx e, ctx.size)
          modify fun s => { s with cands := s.cands.push c }
        else modify fun s => { s with nodes := s.nodes + 1 }
    if !headOk && nargs ≥ 1 then walk collect f ctx
    for a in e.getAppArgs do walk collect a ctx
  | _ => pure ()

/-- The Tier B candidates of theorem `thm`, in walk order, and whether the walk was cut. -/
def candidates (thm : Name) : MetaM (Array (Expr × Expr × Nat) × Bool) := do
  let some (.thmInfo t) := (← getEnv).find? thm | throwError "not a theorem: {thm}"
  let (_, s) ← (walk true t.value #[]).run {}
  return (s.cands, s.truncated)

/-- Oracle node estimate of a closed proof `fun ctx => e`: proof-valued spines headed by
a constant or a local hypothesis (the λs of the context are entered, not counted). -/
def nodeEstimate (closedProof : Expr) : MetaM (Nat × Bool) := do
  let (_, s) ← (walk false closedProof #[]).run {}
  return (s.nodes, s.truncated)

end Eval
